<div class="container">
    {# add breadcumbs bg-gradient-to-r from-sky-900 to-indigo-950 container in
  pages to make a space in case breadcrumbs is off #}
    <nav class="breadcrumbs w-full py-5 text-white">
        <salla-breadcrumb></salla-breadcrumb>
    </nav>

    <div class="min-h-screen flex flex-col">
        <div class="flex justify-around p-10">
            <!-- Image Section -->
            <div class="w-1/2">
                <img src="{{ product.image.url }}" alt="{{ product.name }}"
                    class="rounded-lg object-cover shadow-lg w-full max-w-md" />
            </div>

            <!-- Details Section -->
            <div class="w-1/2 bg-gradient-to-t from-zinc-800 to-black rounded-big p-10 text-white shadow-2xl">
                <!-- Title and Description -->
                <div class="mb-4 selection:">
                    <h1 class="text-3xl font-bold mb-2">{{ product.name }}</h1>
                    <p class="text-lg">{{ product.description }}</p>
                </div>

                <!-- Price and Call to Actions -->
                <div class="flex items-center justify-between mb-6">
                    <div
                        class="text-4xl font-bold text-white p-4 bg-gradient-to-t from-black to-zinc-800 rounded-lg flex gap-2 items-end">
                        {{ product.price }}
                        <p class="text-sm">
                            ريال
                        </p>
                    </div>
                </div>
                <div>
                    {# is a button #}
                    <div class="my-2 flex gap-3">
                        <div
                            class="text-2xl font-semibold text-white p-2 px-5 bg-gradient-to-t from-black to-zinc-800 rounded-lg flex gap-2 items-end w-max">
                            اطلب الان
                        </div>

                        <div
                            class="text-2xl font-semibold text-white p-2 px-5 bg-gradient-to-t from-black to-zinc-800 rounded-lg flex gap-2 items-end w-max">
                            عرضها
                        </div>
                    </div>

                    <div class="border-t-2 border-main my-2 mt-2 w-full">
                        <div class="flex gap-3 mt-2">
                            <div
                                class="text-2xl font-semibold text-white p-2 px-5 bg-gradient-to-t from-black to-zinc-800 rounded-lg flex gap-2 items-end w-max">
                                48h
                            </div>
                            <div
                                class="text-2xl font-semibold text-white p-2 px-5 bg-gradient-to-t from-black to-zinc-800 rounded-lg flex gap-2 items-end w-max">
                                48h
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <salla-offer></salla-offer>
    </div>

    {# Comments Area #}
    <salla-comments item-id="{{product.id}}" type="product"></salla-comments>

    {# Similar Products Area #}
    <div class="container">
        <salla-products-slider source="related" source-value="{{product.id}}"
            block-title="{{trans('pages.products.similar_products')}}" display-all-url></salla-products-slider>
    </div>
    {% endblock %} {% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
    {% if product.has_3d_image %}
    <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %} {% endblock %}
</div>