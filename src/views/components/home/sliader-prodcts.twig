<div class="container relative p-10 ">
    <!-- Left Navigation Button -->
    <div class="absolute left-5 top-1/2 transform -translate-y-1/2 flex items-center flex-col justify-center">
        <button class=" rounded-full text-white">
        <img src="{{ 'images/icons/button2.svg' | asset }}" alt="ريال" class="w-12 h-12 text-white"> 
        </button>
        <span class="text-white text-sm mt-2 block">السابق</span>
    </div>

    <!-- Right Navigation Button -->

    <div class="absolute right-5 top-1/2 transform -translate-y-1/2 flex items-center flex-col justify-center">
        <button class=" rounded-full text-white">
        <img src="{{ 'images/icons/button.svg' | asset }}" alt="ريال" class="w-12 h-12 text-white">
        </button>
        <span class="text-white text-sm mt-2 block">المزيد</span>
    </div>
  
    <!-- Grid Layout for Cards -->
    <div class="flex flex-wrap gap-4 justify-around items-center max-w-3xl m-auto">
        <!-- Single Card -->
        <div class="text-center md ">
            <div class="bg-zinc-900 w-60 h-60 rounded-lg flex justify-center items-center shadow-lg">
                <img src="{{ 'images/camra.svg' | asset }}" alt="ريال" class="w-8 h-8 text-white">
            </div>
            <div class="bg-gradient-to-t from-black to-zinc-800 rounded-xl px-4 py-2 mt-2 text-start">
                <p class="text-white   font-semibold"><b class=" font-bold text-xl">
                    90
                </b> ريال</p>
            </div>
        </div>
        {% for item in component.products %}
        <a href="{{item.url}}">
            <div class="text-center md ">
                <div class="bg-zinc-900 w-60 h-60 rounded-lg flex justify-center items-center shadow-lg">
                    <img src="{{item.image.url}}" alt="ريال" class="  h-full text-white ">
                </div>
                <div class="bg-gradient-to-t from-black to-zinc-800 rounded-xl px-4 py-2 mt-2 text-start">
                    <p class="text-white   font-semibold"><b class=" font-bold text-xl">
                        {{ item.price }}
                    </b> ريال</p>
                </div>
            </div>
            </a>
        {% endfor %}
  
        <div class="text-center md ">
            <div class="bg-zinc-900 w-60 h-60 rounded-lg flex justify-center items-center shadow-lg">
                <img src="{{ 'images/camra.svg' | asset }}" alt="ريال" class="w-8 h-8 text-white">
            </div>
            <div class="bg-gradient-to-t from-black to-zinc-800 rounded-xl px-4 py-2 mt-2 text-start">
                <p class="text-white   font-semibold"><b class=" font-bold text-xl">
                    90
                </b> ريال</p>
            </div>
        </div>
        <div class="text-center md ">
            <div class="bg-zinc-900 w-60 h-60 rounded-lg flex justify-center items-center shadow-lg">
                <img src="{{ 'images/camra.svg' | asset }}" alt="ريال" class="w-8 h-8 text-white">
            </div>
            <div class="bg-gradient-to-t from-black to-zinc-800 rounded-xl px-4 py-2 mt-2 text-start">
                <p class="text-white   font-semibold"><b class=" font-bold text-xl">
                    90
                </b> ريال</p>
            </div>
        </div>
        <div class="text-center md ">
            <div class="bg-zinc-900 w-60 h-60 rounded-lg flex justify-center items-center shadow-lg">
                <img src="{{ 'images/camra.svg' | asset }}" alt="ريال" class="w-8 h-8 text-white">
            </div>
            <div class="bg-gradient-to-t from-black to-zinc-800 rounded-xl px-4 py-2 mt-2 text-start">
