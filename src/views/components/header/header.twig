        <p class="leading-none text-base font-semibold">الرئيسية</p>
      </a>
    </li>
    {% else %}

    <li class="">
      <a
        href="{{store.url}}"
        class="px-5 py-2 h-12 flex items-center justify-center hoverNav transition-all duration-300 ease-in-out transform focus:outline-none rounded-r"
      >
        <p class="leading-none text-base font-semibold">الرئيسية</p>
      </a>
    </li>

    {% endif %} 
    
    {% if theme.settings.get('c_name')|length %}
