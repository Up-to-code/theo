      <a class="hoverNav px-5 py-2 h-12 flex items-center justify-center transition-all duration-300 ease-in-out transform focus:outline-none focus:ring-2 focus:ring-gray-500 item">
        <p class="leading-none text-base font-semibold">
          {{ theme.settings.get('c_name') }}
        </p>
      </a>
  
      <!-- Dev Menu -->
      <div class="absolute conditional-item top-10 left-0 -right-2 w-max z-10 flex justify-between items-center px-4 md:px-1" dir="">
        <div class="conditional-item mt-5">
          <div class=" bg-zinc-900 rounded w-max px-5 py-2">
            <div class="py-1 px-2 rounded hover:bg-gray-900 transition-colors duration-300">
              item 1
            </div>
            <div class="py-1 px-2 rounded hover:bg-gray-900 transition-colors duration-300">
              item 2
            </div>
            <div class="py-1 px-2 rounded hover:bg-gray-900 transition-colors duration-300">
              item 3
            </div>
          </div>
        </div>
      </div>
    </li>
  {% endif %}
  




    {% for item in theme.settings.get('navbar') %}
    <li class="mx-2">
      <a
        href="{{item.url}}"
        class="hoverNav px-5 py-2 h-12 flex items-center justify-center transition-all duration-300 ease-in-out transform focus:outline-none focus:ring-2 focus:ring-gray-500"
