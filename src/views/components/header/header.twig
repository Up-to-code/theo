  {# Main Nav #}
</header>

<div class=" flex-col gap-3 pt-2">
  {# #}
  <div class=" container"> 

    <nav class="mt-5 flex justify-between items-center w-full px-4 md:px-1" dir="">
      <!-- Logo on the Left -->

      <!-- Mega Menu & User Icons (Right-Aligned) -->
      <div class="flex items-center space-x-4 space-x-reverse"> <!-- Fix spacing for RTL -->
 
    <div class="hidden lg:flex">
 

        <!-- User Icon -->
        {% if user.type == 'user' %}
        <salla-user-menu avatar-only relative-dropdown></salla-user-menu>
        {% else %}
        <button class="p-2 rounded-md focus:outline-none" onclick="salla.event.dispatch('login::open')">
          <img src="{{ 'images/icons/usera.png' | asset }}" alt="User Icon" class="w-6 h-6" loading="lazy" />
        </button>
        {% endif %}
    <div class="flex items-center">
 
        <!-- Search Icon -->
        <button class="p-2 rounded-md focus:outline-none" onclick="salla.event.dispatch('search::open')">
          <img src="{{ 'images/icons/search.png' | asset }}" alt="Search Icon" loading="lazy" class="w-32" />
        </button> 
        <salla-cart-summary class="ml-4 rtl:ml-[unset] rtl:mr-4">
          <i slot="icon" class="sicon-shopping-bag text-white text-2xl" style="position: relative; bottom: -3px; left: -3px;"></i>
        </salla-cart-summary>  
    
      </div>
      </div>
      <!-- Mega Menu Button (Desktop Only) -->
      <button class="lg:hidden text-white focus:outline-none " onclick="toggleDrawer()">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <salla-cart-summary class="ml-4 rtl:ml-[unset] rtl:mr-4 block md:hidden">
        <i slot="icon" class="sicon-shopping-bag text-white text-2xl" style="position: relative; bottom: -3px; left: -3px;"></i>
      </salla-cart-summary>  
      </div>
     <div>
      

    
 
     </div>
      <!-- Drawer Toggle (Mobile Only) -->
 
      <!-- Drawer Overlay and Content (Mobile) -->
      <div id="drawerOverlay" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50" onclick="closeDrawer()">
        <div class="w-64 bg-dark h-full p-4 shadow-lg transform translate-x-full transition-transform duration-300" id="drawerContent" onclick="event.stopPropagation()">
          <button class="text-gray-500 hover:text-gray-700 focus:outline-none" onclick="closeDrawer()">
            <!-- Close Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
    
          <!-- Drawer Content: User & Search Icons + Mega Menu Links -->
          <div class="mt-6 space-y-4">
            <!-- User Icon in Drawer -->
            <div>
              {% if user.type == 'user' %}
              <salla-user-menu avatar-only relative-dropdown></salla-user-menu>
              {% else %}
              <button class="p-2 rounded-md focus:outline-none" onclick="salla.event.dispatch('login::open')">
                <img src="{{ 'images/icons/usera.png' | asset }}" alt="User Icon" class="w-6 h-6" loading="lazy" />
              </button>
              {% endif %}
            </div>
    
            <!-- Search Icon in Drawer -->
            <button class="p-2 rounded-md focus:outline-none" onclick="salla.event.dispatch('search::open')">
              <img src="{{ 'images/icons/search.png' | asset }}" alt="Search Icon" loading="lazy" class="w-32" />
            </button>
    
            <!-- Mega Menu Links -->
            <ul class="mt-6">
              <li>
                <a href="{{ store.url }}" class="block px-5 py-2 h-12 flex items-center hover:bg-gray-900 transition-colors duration-300">
                  الرئيسية
                </a>
              </li>
              {% for item in theme.settings.get('navbar') %}
              <li>
                <a href="{{ item.url }}" class=" px-5 py-2 h-12 flex items-center hover:bg-gray-900 transition-colors duration-300">
                  {{ item.title }}
                </a>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>




  {% if is_home %}
  <a href="{{ store.url }}" class="flex items-center scale-75 md:scale-100">
    <img src="{{ store.logo }}" alt="Logo" class="h-10 md:h-32" />
  </a>

  {% else %}
    
      <a href="{{ store.url }}" class="flex items-center scale-75 md:scale-100">
        <img src="{{ store.logo }}" alt="Logo" class="h-10 md:h-24" />
      </a>
      {% endif %}
    </nav>
        
