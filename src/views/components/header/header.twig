  {# Main Nav #}
</header>

<div class="flex justify-center flex-col gap-3">
  {# #}
  <div class="flex items-center container"></div>

  <nav class="mt-5 flex justify-between w-full px-4">
    <div>
      <div class="flex items-center mx-5 space-x-4 rtl:space-x-reverse">
        {% if user.type == 'user' %}
        <salla-user-menu avatar-only relative-dropdown></salla-user-menu>
        {% else %}
        <button
          class="header-btn p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500"
          aria-label="Login"
          onclick="salla.event.dispatch('login::open')"
        >
          <div class="flex items-center justify-center">
            <img
              src="{{ 'images/icons/usera.png' | asset }}"
              alt="User Icon"
              class="w-6 h-6"
              loading="lazy"
            />
          </div>
        </button>
        {% endif %}

        <salla-cart-summary class="ml-4 rtl:ml-[unset] rtl:mr-4">
          <i
            slot="icon"
            class="sicon-shopping-bag text-white text-2xl"
            style="position: relative; bottom: -3px; left: -3px;"
          ></i>
        </salla-cart-summary>

        <!-- Inline Search Bar Input Field-->
        <salla-search inline="true" height="50"></salla-search>
      </div>
      <div class="h-[48px] bg-opacity-90 flex justify-between">
        <ul
          class="flex rounded-xl w-max text-white overflow-hidden h-full"
          style="
    background-image: url('{{ 'images/Calque_1.svg' | asset }}');
    background-size: cover;
    background-position: center;
  "
        >
          <!-- Navigation Item: الرئيسية -->
          {% if is_home %}
          <li class="">
            <a
              href="{{store.url}}"
              class="activeNav px-5 py-2 h-12 flex items-center justify-center hoverNav transition-all duration-300 ease-in-out transform focus:outline-none"
            >
              <p class="leading-none text-base font-semibold">الرئيسية</p>
            </a>
          </li>
          {% else %}

          <li class="">
            <a
              href="{{store.url}}"
              class="px-5 py-2 h-12 flex items-center justify-center hoverNav transition-all duration-300 ease-in-out transform focus:outline-none"
            >
              <p class="leading-none text-base font-semibold">الرئيسية</p>
            </a>
          </li>

          {% endif %} {% for item in theme.settings.get('navbar') %}
          <li class="mx-2">
            <a
              href="{{item.url}}"
              class="hoverNav px-5 py-2 h-12 flex items-center justify-center transition-all duration-300 ease-in-out transform focus:outline-none focus:ring-2 focus:ring-gray-500"
            >
              <p class="leading-none text-base font-semibold">
                {{ item.title }}
              </p>
            </a>
          </li>

          {% endfor %}
          <div>
            <button
              class="header-btn p-2 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-500"
              aria-label="Login"
              onclick="salla.event.dispatch('search::open')"
              style="
                position: relative;
                bottom: -3px;
                left: -3px;
              "
            >
              <i class="sicon-search"></i>
            </button>
          </div>
        </ul>
      </div>
    </div>

    {% if is_home %}
    <img src="{{ store.logo }}" alt="Logo" class=" " />
    {% else %}
    <div class="flex items-center justify-center">
      <img src="{{ store.logo }}" alt="Logo" class="h-14" />
    </div>
    {% endif %}
  </nav>
  <div>
    <!-- Button to open search component-->
  </div>
</div>

{% if store.scope %}
<salla-scopes
  selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"
></salla-scopes>
{% endif %}
