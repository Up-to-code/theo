     <script>
      function toggleDrawer() {
        const overlay = document.getElementById('drawerOverlay');
        overlay.classList.toggle('hidden');
        const drawerContent = document.getElementById('drawerContent');
        drawerContent.classList.toggle('translate-x-full');
        drawerContent.classList.toggle('translate-x-0');
      }
    
      function closeDrawer() {
        document.getElementById('drawerOverlay').classList.add('hidden');
        document.getElementById('drawerContent').classList.add('translate-x-full');
      }
    
      function toggleMegaMenu() {
        // Add any necessary Mega Menu toggle logic here
      }
    </script>