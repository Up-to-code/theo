{% set color =  theme.settings.get('footer_font_color') %}
{% set bg =  theme.settings.get('footer_color') %}

<footer class="store-footer">
	<div 
	  style="
		background-color: {{ bg }} ;
		color: {{ color }} ;
	  "
	  class="min-h-16 flex flex-col md:flex-row justify-between px-5 py-6"
	>



	  {# footer_links #}
	  {% if theme.settings.get('footer_links') %}
		{% set footer_links = theme.settings.get('footer_links') %}
		<div class="flex flex-wrap gap-6 mb-4 md:mb-0">
		  {% for link in footer_links %}
			<a 
			  href="{{ link.url }}" 
			  class="text-lg  p-6 relative flex items-center justify-center rounded-full"
			  style="
			   background-color: {{ color}} ;
			  "
			 
			>
			  <i class="{{ link.icon  }} absolute  "
			    style="
				  color: {{ bg }} ;
				  background-color: {{ color }} ;
				"
			  
			 
			  ></i>
			</a>
		  {% endfor %}
		</div>
	  {% endif %}
	  <div>
		{% if theme.settings.get('footer_logo') %}
			<a href="{{ store.url }}" class="flex items-center">
				<img
					src="{{ theme.settings.get('footer_logo') }}"
					alt="{{ store.name }} logo"
					class="h-12 w-auto"
				/>
		</a>
		{% endif %}
	</div>
	</div>
  
	<!-- Bottom Section -->
	<div class="md:flex items-center justify-between py-4 w-full md:w-auto text-center">
	  <span class="text-sm text-white font-semibold">{% hook copyright %}</span>
	  <salla-payments class="mt-4 md:mt-0"></salla-payments>
	</div>
  
	<!-- Hidden element (preserved for future use) -->
	<span class="hidden bottom-2 rtl:pl-24 ltr:pr-24 md:grid-cols-3"></span>
  </footer>
  